# 文本文件统一在版本库内使用 LF 存储（.bat/.cmd 例外，必须 CRLF 才能双击运行）
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
gradlew text eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# 二进制文件不做换行转换
*.apk   binary
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
